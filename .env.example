# ==============================================================================
# The Property Scout — Environment Configuration Template
# Copy this file to '.env' and fill in your real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Databases (Cloud Option Selected)
# ------------------------------------------------------------------------------
# Relational DB (PostgreSQL)
# For Supabase, get the connection string from: Project Settings -> Database -> Connection string (URI mode)
# Example: postgresql://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=your_supabase_connection_string_here

# Vector Database (Qdrant Cloud)
# Create a free cluster on Qdrant Cloud (https://cloud.qdrant.io/)
# Get the Cluster URL (ends in qdrant.io) and generate an API key
VECTOR_DB_URL=https://xxxxxx.gcp.qdrant.io:6333
VECTOR_DB_API_KEY=your_qdrant_cloud_api_key_here

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# API Key for LLM Orchestrator (e.g. OpenAI/Anthropic)
LLM_API_KEY=your_openai_or_anthropic_api_key_here
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Voice Service Configuration
# ------------------------------------------------------------------------------
# Deepgram / Whisper API Key for Speech-To-Text (STT)
STT_API_KEY=your_deepgram_api_key_here

# ElevenLabs / OpenAI API Key for Text-To-Speech (TTS)
TTS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# Notification Configuration (N8N Webhooks)
# ------------------------------------------------------------------------------
# N8N workflow webhook paths
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
N8N_BOOKING_WEBHOOK_PATH=/booking
N8N_SHORTLIST_WEBHOOK_PATH=/shortlist

# Email configuration
SENDER_EMAIL=noreply@thepropertyscout.in

# ------------------------------------------------------------------------------
# OpenStreetMap MCP
# ------------------------------------------------------------------------------
OSM_MCP_ENDPOINT=http://localhost:8080
